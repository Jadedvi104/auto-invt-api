# Local development only. Copy to .env and choose a unique password.
# Use URL-safe letters and digits here because Compose embeds it in DATABASE_URL.
POSTGRES_USER=inventory
POSTGRES_DB=inventory
POSTGRES_PASSWORD=replace_with_a_unique_local_password

# Native uv development defaults to SQLite when DATABASE_URL is not supplied.
# For native PostgreSQL development, set an escaped SQLAlchemy URL in your shell:
# DATABASE_URL=postgresql+psycopg://inventory:YOUR_PASSWORD@localhost:5432/inventory
# Optional: change the local PostgreSQL port if 5432 is already occupied.
# POSTGRES_PORT=5432
